# Local copy: cp .env.example .env — never commit .env

# Port (Render sets PORT automatically)
PORT=3000

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
# Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / publishable key (browser + RLS). Same value as "anon public" in dashboard.
SUPABASE_ANON_KEY=your_anon_key_here
# Alias supported by server:
# SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Service role key — server API (Render env, never in git). Dashboard: Settings → API → service_role
SUPABASE_SECRET_KEY=your_service_role_key_here
# Alias also accepted:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
